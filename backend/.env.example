# Copy this file to .env and adjust values for your environment.
#
# Local development (default below) — the network-viz-mongo Docker container on port 27018.
# Run: docker run -d --name network-viz-mongo -p 27018:27017 --restart unless-stopped mongo:7
#
# Shared/cloud development — point MONGODB_URI at a MongoDB Atlas cluster instead
# (mongodb+srv://<user>:<password>@<cluster-host>/?...). Never commit a real Atlas
# URI here or anywhere else — this file is an example only, and backend/.env
# (where the real value belongs) is gitignored.

MONGODB_URI=mongodb://localhost:27018
MONGODB_DATABASE=network_visualizer

# Server selection timeout, in milliseconds — how long the backend waits for a
# MongoDB connection before giving up and falling back to "MongoDB unavailable"
# mode. 5000ms (5s) is a safe default for both local MongoDB and a remote
# cluster like Atlas (DNS/SRV resolution + TLS handshake + replica-set
# discovery can take longer than the old 500ms default over a real network).
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# CORS — deployed frontend origin(s), on top of the localhost dev origins the
# backend always allows (see app/main.py's LOCAL_DEV_ORIGINS — unaffected by
# this variable). Leave unset for local development. Set this in production
# (e.g. Render's environment variable settings) to the exact origin your
# frontend is served from — scheme + host, no path, no trailing slash — or
# every cross-origin request from the deployed frontend will be rejected by
# the browser with a CORS error, even though the backend itself is healthy.
# FRONTEND_ORIGIN takes one origin; FRONTEND_ORIGINS takes a comma-separated
# list (e.g. production + a preview deploy) — set whichever fits, both are
# read and merged. Never use "*" here; this app pairs CORS with
# allow_credentials=True, and browsers reject a wildcard origin combined
# with credentials outright.
# FRONTEND_ORIGIN=https://your-frontend.onrender.com
# FRONTEND_ORIGINS=https://your-frontend.onrender.com,https://your-preview-deploy.onrender.com
